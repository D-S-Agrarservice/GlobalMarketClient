# Default: auto-detect text files and normalize to LF in the repository
* text=auto eol=lf

# Rust, TypeScript, Web & Config files explicitly LF across Windows/macOS/Linux
*.rs      text eol=lf
*.toml    text eol=lf
*.lock    text eol=lf
*.ts      text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.xml     text eol=lf
*.svg     text eol=lf

# Windows-specific scripts keep CRLF if ever added
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary assets
*.png     binary
*.ico     binary
*.icns    binary
*.dds     binary
*.woff2   binary
