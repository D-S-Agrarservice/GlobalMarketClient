{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GlobalMarketClient",
  "mainBinaryName": "GlobalMarketClient",
  "version": "0.9.11",
  "identifier": "de.ds-agrarservice.globalmarket-client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GlobalMarket – D-S-Agrarservice (Beta)",
        "width": 860,
        "height": 670,
        "minWidth": 760,
        "minHeight": 550,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCRTcwOTk0Q0MxMUUzNkQKUldSdDR4SE1sQW5uNjd6YkpTRDNSWDRNaGVGZmRsWEJMTEEwLzJibkozMWszYzBIaFRRK0dFZzAK",
      "endpoints": [
        "https://github.com/D-S-Agrarservice/GlobalMarketClient/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
